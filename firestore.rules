rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    match /appData/{document=**} {
      allow read, write: if true;
    }
    match /appData/shared_company_data {
      allow read, write: if true;
    }
  }
}
