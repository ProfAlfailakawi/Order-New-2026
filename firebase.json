{
  "firestore": {
    "database": "ai-studio-98ab722d-c952-4f80-bf8a-86a041d1c25b",
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "gen-lang-client-0878573239",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "order",
          "region": "europe-west3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
